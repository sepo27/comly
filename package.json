{
  "name": "comly",
  "description": "Command Line Framework",
  "version": "0.2.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": "./bin/comly-bin.sh",
  "scripts": {
    "build": "tsc -p ./tsconfig.build.json",
    "lint": "eslint ./src",
    "typecheck": "tsc --noEmit",
    "prepare": "husky && pnpm run build",
    "version": "conventional-changelog -i CHANGELOG.md -s -n .versionrc.js && git add CHANGELOG.md"
  },
  "files": [
    "dist/",
    "bin/",
    "README.md",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "commander": "^15.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "eslint": "^10.14.0",
    "globals": "^16.0.0",
    "husky": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2"
  },
  "keywords": [
    "CLI",
    "Command Line Framework"
  ],
  "author": "Sergey Poskachey",
  "license": "ISC"
}
