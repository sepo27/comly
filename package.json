{
  "name": "Comly",
  "description": "Command Line Framework",
  "version": "0.0.2",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "lint": "eslint ./src",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "version": "conventional-changelog -i CHANGELOG.md -s && git add CHANGELOG.md"
  },
  "keywords": [
    "CLI",
    "Command Line Framework"
  ],
  "author": "Sergey Poskachey",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "eslint": "^10.14.0",
    "globals": "^16.0.0",
    "husky": "^9.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
