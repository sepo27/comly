{
  "name": "comly",
  "description": "Command Line Framework",
  "version": "0.7.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": "./binCli/dist/bin/comly.js",
  "scripts": {
    "build": "tsc -p ./tsconfig.build.json",
    "lint": "eslint ./src",
    "typecheck": "tsc --noEmit",
    "bin-cli:lint": "eslint ./binCli/src -c ./eslint.config.js",
    "bin-cli:typecheck": "tsc --noEmit",
    "bin-cli:build": "pnpm bin-cli bin make -s ./binCli/src -d ./binCli/dist/bin/comly.js -v",
    "bin-cli": "tsx ./binCli/src",

    "prepare": "husky && pnpm build && pnpm bin-cli:build",
    "version": "conventional-changelog -i CHANGELOG.md -s -n .versionrc.js && git add CHANGELOG.md"
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md"
  ],
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "keywords": [
    "CLI",
    "Command Line Framework"
  ],
  "author": "Sergey Poskachey",
  "license": "ISC",
  "dependencies": {
    "commander": "^15.0.0"
  },
  "peerDependencies": {
    "ts-loader": "^9.6.2",
    "webpack": "^5.112.2"
  },
  "peerDependenciesMeta": {
    "webpack": {
      "optional": true
    },
    "ts-loader": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "eslint": "^10.14.0",
    "globals": "^16.0.0",
    "husky": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2"
  }
}
